{
  "python.defaultInterpreterPath": "${workspaceFolder}/cloud-run/.venv/bin/python",
  "python.testing.unittestEnabled": true,
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    "cloud-run/tests",
    "-p",
    "test_*.py"
  ],
  "python.testing.pytestEnabled": false,
  "files.exclude": {
    "**/__pycache__": true,
    "**/.venv": true
  }
}
